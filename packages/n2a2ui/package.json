{
  "name": "n2a2ui",
  "version": "0.8.0",
  "description": "Convert Notion blocks into A2UI v0.9 components using the Elmethis Notion Block Catalog.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.3",
  "author": "Ikuma Yamashita",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/46ki75/n2a2ui.git",
    "directory": "packages/n2a2ui"
  },
  "keywords": [
    "notion",
    "a2ui"
  ],
  "scripts": {
    "prepublishOnly": "pnpm run build",
    "build": "tsdown",
    "ci": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "coverage": "vitest run --coverage",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a2ui/web_core": "^0.10.7",
    "@elmethis/core": "^0.24.0",
    "@notionhq/client": "^5.26.0",
    "cheerio": "^1.1.2",
    "image-size": "^2.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.7.4",
    "tsdown": "^0.22.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.0"
  }
}
